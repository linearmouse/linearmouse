#!/usr/bin/env python3
"""Run app tests with Debug isolation and a disposable Foundation home.

--optimized enables Swift optimization without changing DEBUG/test-host guards.
The generated xctestrun changes only the test process environment, not the user's
HOME, configuration, preferences, or Xcode project build settings.
"""

import argparse
import os
from pathlib import Path
import plistlib
import subprocess
import tempfile
import uuid


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--optimized", action="store_true")
    parser.add_argument("--derived-data", type=Path)
    parser.add_argument("--only-testing", action="append", default=[])
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    derived = args.derived_data or Path(tempfile.mkdtemp(prefix="linearmouse-test-build-"))
    derived = derived.resolve()
    destination = "platform=macOS,arch=" + os.uname().machine
    build = [
        "xcodebuild", "build-for-testing", "-project", str(root / "LinearMouse.xcodeproj"),
        "-scheme", "LinearMouse", "-configuration", "Debug", "-destination", destination,
        "-derivedDataPath", str(derived), "CODE_SIGNING_ALLOWED=NO", "ONLY_ACTIVE_ARCH=YES",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS=$(inherited) DEBUG",
    ]
    if args.optimized:
        build.append("SWIFT_OPTIMIZATION_LEVEL=-O")
    subprocess.run(build, cwd=root, check=True)
    products = derived / "Build" / "Products"
    plans = sorted(p for p in products.glob("LinearMouse_*.xctestrun") if "isolated" not in p.name)
    if len(plans) != 1:
        raise RuntimeError("Expected one generated test plan; use a dedicated derived-data directory")
    with plans[0].open("rb") as source:
        plan = plistlib.load(source)
    target = plan["LinearMouseUnitTests"]
    if "/Debug/" not in target["TestHostPath"]:
        raise RuntimeError("Refusing to run a non-Debug test host")
    with tempfile.TemporaryDirectory(prefix="linearmouse-test-home-") as test_home:
        for key in ("EnvironmentVariables", "TestingEnvironmentVariables"):
            target.setdefault(key, {}).update({
                "CFFIXED_USER_HOME": test_home,
                "LINEARMOUSE_EXPECTED_TEST_HOME": test_home,
            })
            if args.optimized:
                # Compare pipeline work without Xcode collecting a log per drag.
                target[key]["OS_ACTIVITY_MODE"] = "disable"
        isolated = products / "LinearMouse_isolated.xctestrun"
        with isolated.open("wb") as output:
            plistlib.dump(plan, output)
        result = derived / "Logs" / "Test" / ("Isolated-" + uuid.uuid4().hex + ".xcresult")
        result.parent.mkdir(parents=True, exist_ok=True)
        command = ["xcodebuild", "test-without-building", "-xctestrun", str(isolated),
                   "-destination", destination, "-parallel-testing-enabled", "NO",
                   "-resultBundlePath", str(result)]
        for test in args.only_testing:
            command.append("-only-testing:" + test)
        print("Test home:", test_home, flush=True)
        try:
            subprocess.run(command, cwd=root, check=True)
        finally:
            isolated.unlink(missing_ok=True)
    print("Test results:", result)


if __name__ == "__main__":
    main()
